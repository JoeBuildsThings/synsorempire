# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase: Project Settings, API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudinary: dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The live address of the site, no trailing slash. Used for WhatsApp product links, the sitemap and share previews.
NEXT_PUBLIC_SITE_URL=

# Optional: the Google Search Console verification token
NEXT_PUBLIC_GOOGLE_VERIFICATION=
